[flake8]
# Maximum line length
max-line-length = 120

# List of files and directories to exclude
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    node_modules,
    build,
    dist,
    *.egg-info,
    .pytest_cache,
    .mypy_cache,
    .tox

# Error codes to ignore
# E203: whitespace before colon
# E501: line too long (handled by black)
# W503: line break before binary operator
# W504: line break after binary operator
# E266: too many leading hashes for block comment
# E402: module level import not at top of file
# C901: function too complex (handled by pylint)
# F541: f-string without placeholders
# E721: do not compare types (use isinstance)
# F401: imported but unused
# F811: redefinition of unused
# F841: local variable assigned but never used
ignore =
    E203,
    E501,
    W503,
    W504,
    E266,
    E402,
    C901,
    F541,
    E721,
    F401,
    F811,
    F841

# Maximum complexity
max-complexity = 10

# Show source code for each error
show-source = True

# Show the relevant text for each error
show-pep8 = True

# Count the number of occurrences of each error/warning code
count = True

# Print total number of errors
statistics = True
