# Environment Configuration for Fast-Detect-GPT Service
# Copy this file to .env and configure for your environment

# Environment mode: development or production
# development: Uses GPT-2 (lightweight, ~500MB, runs on minimal hardware)
# production: Uses GPT-J-6B (accurate, ~24GB, requires GPU cloud infrastructure)
ENVIRONMENT=development

# API Configuration
API_PORT=8001
API_HOST=0.0.0.0

# Model Cache Directory (inside container)
CACHE_DIR=/app/cache

# GPU Device (cuda or cpu)
DEVICE=cuda

# Flask Configuration
FLASK_DEBUG=true
FLASK_ENV=development
